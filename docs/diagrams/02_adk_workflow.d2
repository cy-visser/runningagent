direction: down

vars: {
  d2-config: {
    layout-engine: elk
  }
}

classes: {
  compute: {style.fill: "#e8f0fe"; style.stroke: "#1a73e8"; style.border-radius: 6}
  web: {style.fill: "#fff7ed"; style.stroke: "#f97316"; style.border-radius: 6}
  ai: {style.fill: "#e6f4ea"; style.stroke: "#137333"; style.border-radius: 6}
  det: {style.fill: "#ffffff"; style.stroke: "#5f6368"; style.border-radius: 6}
  data: {shape: cylinder; style.fill: "#fff8e1"; style.stroke: "#f9ab00"}
  core: {style.fill: "#f3e8fd"; style.stroke: "#8430ce"; style.border-radius: 6; style.bold: true}
  decision: {shape: diamond; style.fill: "#fef7e0"; style.stroke: "#f9ab00"}
}

web_client: "Cloud Run Web App\n(IAP + /run_sse)" {class: web}
session: "Firestore\n(sessions, users.email,\nprivate/trainingpeaks)" {class: data}

app: "ADK App: running_coach" {
  style.fill: "#f8f9fa"
  style.stroke: "#bdc1c6"

  start: "START" {shape: circle; class: det}
  router: "profile_router\n(email lookup + KMS cred check)" {class: decision}

  not_linked: "not_linked_node\n(directs to Web App)" {class: det}
  not_connected: "tp_not_connected_node\n(reconnect TP in Web App)" {class: det}
  unavailable: "profile_unavailable_node\n(fixed message)" {class: det}

  onboarding: "onboarding_node" {
    class: det
    agent: "onboarding_agent\nLLM, task mode\n(flash-lite)" {class: ai}
    save: "create_profile_step\n(geocode + merge profile)" {class: det}
    agent -> save: "OnboardingAnswers"
  }

  coaching: "coaching_node" {
    class: det
    agent: "coaching_agent\nLLM, chat mode\n(flash)" {class: core}
    tools: "load_skill + feature tools\n(+ report_data stateDelta)" {class: compute}
    agent <-> tools: "tool calls"
  }

  start -> router
  router -> not_linked: "no linked profile"
  router -> not_connected: "missing TP cookie"
  router -> onboarding: "skeleton profile /\nre-onboard"
  router -> coaching: "profile + TP ready"
  router -> unavailable: "Firestore\nunreachable"
}

web_client -> app.start: "user:auth_email\n(user_id = web_<email>)"
app.router <-> session: "email -> runner_id,\nuser_profile"
app.onboarding.save -> session: "user_profile"
