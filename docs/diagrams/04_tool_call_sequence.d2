shape: sequence_diagram

runner: "Runner"
coach: "coaching_agent"
gemini: "Gemini"
skill: "load_skill"
facade: "fetch_checkin_data\n(facade)"
tp: "tp-mcp\n(TrainingPeaks)"
meteo: "Open-Meteo"

runner -> coach: "\"How was my week?\""
coach -> gemini: "prompt + profile + skill catalog"
gemini -> coach: "call load_skill(check-in-report)"
coach -> skill: "load"
skill -> coach: "SKILL.md protocol"
coach -> gemini: "skill instructions"
gemini -> coach: "call fetch_checkin_data()"
coach -> facade: "invoke"
facade -> tp: "workouts, notes, metrics,\nfitness, analyses (parallel)"
facade -> meteo: "hourly weather per run"
tp -> facade: "raw data"
meteo -> facade: "conditions"
facade -> coach: "compact summary text"
coach -> gemini: "tool result"
gemini -> coach: "check-in report"
coach -> runner: "report (offer to save)"
