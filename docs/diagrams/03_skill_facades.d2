direction: right

vars: {
  d2-config: {
    layout-engine: elk
  }
}

classes: {
  skill: {style.fill: "#f3e8fd"; style.stroke: "#8430ce"; style.border-radius: 6}
  facade: {style.fill: "#e8f0fe"; style.stroke: "#1a73e8"; style.border-radius: 6}
  helper: {style.fill: "#ffffff"; style.stroke: "#5f6368"; style.border-radius: 6}
  ext: {style.fill: "#fce8e6"; style.stroke: "#c5221f"; style.border-radius: 6}
  data: {shape: cylinder; style.fill: "#fff8e1"; style.stroke: "#f9ab00"}
  ai: {style.fill: "#e6f4ea"; style.stroke: "#137333"; style.border-radius: 6; style.bold: true}
}

coach: "coach/coaching/\ncoaching_agent" {class: ai}

features: "features/<feature>/ (skill + tool + private helpers)" {
  style.fill: "#f8f9fa"
  style.stroke: "#bdc1c6"

  ci: "check_in_report/\ncheck-in-report/SKILL.md\nfetch_checkin_data_tool.py + helpers/" {class: facade}
  ta: "trend_analysis/\ntrend-analysis/SKILL.md\nfetch_trend_data_tool.py + helpers/" {class: facade}
  wa: "workout_analysis/\nworkout-analysis + bike-workout-analysis\nanalyze_workout_tool.py + helpers/" {class: facade}
  sa: "schedule_audit/\nschedule-audit/SKILL.md\nfetch_schedule_audit_data_tool.py + helpers/" {class: facade}
  np: "nutrition_planner/\nnutrition-planner/SKILL.md\nfetch_nutrition_context_tool.py + helpers/" {class: facade}
  wc: "workout_creator/\nworkout-creator/SKILL.md\ncreate_workout_tool.py + create_note_tool.py" {class: facade}
  wl: "weather_lookup/\nget_weather_tool.py" {class: facade}
}

shared: "shared/\n(domain helpers used by 2+ features)" {class: helper}

integrations: "integrations/ (external I/O)" {
  style.fill: "#f8f9fa"
  style.stroke: "#bdc1c6"
  tp: "trainingpeaks/\n(credentials, mcp_toolsets, tp_calls)" {class: ext}
  meteo: "open_meteo.py" {class: ext}
  fs: "firestore.py\n(profiles, training_log, cache)" {class: data}
}

coach -> features: "load_skill + 1 tool call" {style.bold: true}
features -> shared
features -> integrations.tp
features -> integrations.meteo
features -> integrations.fs
shared -> integrations.tp
shared -> integrations.meteo
shared -> integrations.fs
