direction: down

vars: {
  d2-config: {
    layout-engine: elk
  }
}

classes: {
  person: {shape: person; style.fill: "#ffffff"; style.stroke: "#5f6368"}
  compute: {style.fill: "#e8f0fe"; style.stroke: "#1a73e8"; style.border-radius: 6}
  web: {style.fill: "#fff7ed"; style.stroke: "#f97316"; style.border-radius: 6}
  ai: {style.fill: "#e6f4ea"; style.stroke: "#137333"; style.border-radius: 6}
  sec: {style.fill: "#fef7e0"; style.stroke: "#f9ab00"; style.border-radius: 6}
  data: {shape: cylinder; style.fill: "#fff8e1"; style.stroke: "#f9ab00"}
  core: {style.fill: "#f3e8fd"; style.stroke: "#8430ce"; style.border-radius: 6; style.bold: true}
  ext: {style.fill: "#fce8e6"; style.stroke: "#c5221f"; style.border-radius: 6}
}

runner: "Runner\n(IAM account)" {class: person}

gcp: "Google Cloud (europe-west4)" {
  style.fill: "#f8f9fa"
  style.stroke: "#bdc1c6"

  webapp: "Cloud Run Web App\n(running-coach-web + IAP)" {class: web}
  runtime: "Vertex AI Agent Runtime" {
    class: compute
    core: "Running Coach agent\n(ADK Workflow)" {class: core}
  }
  kms: "Cloud KMS\n(tp-cookie key)" {class: sec}
  gemini: "Gemini on Vertex AI" {class: ai}
  firestore: "Firestore Enterprise\n(profiles, KMS creds, sessions, log)" {class: data}

  webapp -> runtime.core: "HTTPS /run_sse"
  webapp -> firestore: "profiles + KMS ciphertext"
  webapp -> kms: "encrypt cookie"
  runtime.core -> kms: "decrypt cookie"
  runtime.core -> gemini: "LLM calls"
  runtime.core -> firestore: "read / write"
}

external: "External services" {
  style.fill: "#f8f9fa"
  style.stroke: "#bdc1c6"

  tp: "TrainingPeaks API\n(workouts, metrics, calendar)" {class: ext}
  meteo: "Open-Meteo\n(geocoding, weather)" {class: ext}
}

runner -> gcp.webapp: "HTTPS (IAP)"
gcp.webapp -> external.tp: "validate cookie"
gcp.runtime.core -> external.tp: "MCP (tp-mcp)"
gcp.runtime.core -> external.meteo: "HTTPS"
