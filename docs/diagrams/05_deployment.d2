direction: down

vars: {
  d2-config: {
    layout-engine: elk
  }
}

classes: {
  person: {shape: person; style.fill: "#ffffff"; style.stroke: "#5f6368"}
  compute: {style.fill: "#e8f0fe"; style.stroke: "#1a73e8"; style.border-radius: 6}
  web: {style.fill: "#fff7ed"; style.stroke: "#f97316"; style.border-radius: 6}
  ai: {style.fill: "#e6f4ea"; style.stroke: "#137333"; style.border-radius: 6}
  sec: {style.fill: "#fff8e1"; style.stroke: "#f9ab00"; style.border-radius: 6}
  data: {shape: cylinder; style.fill: "#fff8e1"; style.stroke: "#f9ab00"}
  core: {style.fill: "#f3e8fd"; style.stroke: "#8430ce"; style.border-radius: 6; style.bold: true}
  tool: {style.fill: "#ffffff"; style.stroke: "#5f6368"; style.border-radius: 6}
}

dev: "Developer" {class: person}

tooling: "Deploy tooling" {
  style.fill: "#f8f9fa"
  style.stroke: "#bdc1c6"
  tf: "Terraform\n(APIs, SAs, KMS key,\nFirestore indexes, traces)" {class: tool}
  deploy: "deploy.sh\n(--target ge | web | both)" {class: tool}
}

gcp: "Google Cloud project (europe-west4)" {
  style.fill: "#f8f9fa"
  style.stroke: "#bdc1c6"

  ge: "Gemini Enterprise app\n\"Running Coach\"" {class: compute}
  webapp: "Cloud Run: running-coach-web\n(Direct IAP --no-allow-unauthenticated)" {class: web}

  runtime: "Vertex AI Agent Runtime\n(container: adk api_server --a2a)" {
    class: compute
    agent: "Running Coach agent" {class: core}
    mcp: "tp-mcp pool\n(per-runner stdio)" {class: tool}
    agent -> mcp
  }

  agent_sa: "SA: running-coach-agent\n(KMS Decrypter)" {class: sec}
  web_sa: "SA: running-coach-web\n(KMS Encrypter)" {class: sec}
  kms: "Cloud KMS\nrunning-coach/tp-cookie" {class: sec}
  gemini: "Gemini" {class: ai}
  firestore: "Firestore Enterprise\nrunning-coach DB" {class: data}

  telemetry: "Observability" {
    style.fill: "#ffffff"
    style.stroke: "#bdc1c6"
    trace: "Cloud Trace / Logging\n(NO_CONTENT)" {class: tool}
    gcs: "gs://traces_runningagent\n(prompt/response JSONL)" {class: data}
  }

  ge -> runtime.agent: "A2A"
  webapp -> runtime.agent: "/run_sse"
  webapp -> web_sa: "runs as" {style.stroke-dash: 3}
  runtime -> agent_sa: "runs as" {style.stroke-dash: 3}
  web_sa -> kms: "encrypt" {style.stroke-dash: 3}
  agent_sa -> kms: "decrypt" {style.stroke-dash: 3}
  webapp -> firestore
  runtime.agent -> gemini
  runtime.agent -> firestore
  runtime.agent -> telemetry.trace: "OTel"
  runtime.agent -> telemetry.gcs: "completions"
}

dev -> tooling.tf
dev -> tooling.deploy
tooling.tf -> gcp: "provision"
tooling.deploy -> gcp.runtime: "always deploy agent"
tooling.deploy -> gcp.ge: "--target ge|both"
tooling.deploy -> gcp.webapp: "--target web|both"
