# Copy to .env and fill in. deploy.sh and agents-cli pass these to the Agent Runtime.
# Never put TP_AUTH_COOKIE here.

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
FIRESTORE_PROJECT_ID=YOUR_PROJECT_ID
# Location of the model calls (the Agent Runtime itself is deployed to europe-west4).
GOOGLE_CLOUD_LOCATION=global
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
GOOGLE_API_USE_MTLS_ENDPOINT=never
FIRESTORE_DATABASE=running-coach
TP_COOKIE_KMS_KEY=projects/YOUR_PROJECT_ID/locations/europe-west4/keyRings/running-coach/cryptoKeys/tp-cookie
WEB_APP_URL=https://running-coach-web-YOUR_PROJECT_NUMBER.europe-west4.run.app
DEV_RUNNER_EMAIL=you@yourdomain.com
PYTHONPATH=/app/agents/running_coach

# Models. The coach falls back to COACH_FALLBACK_MODEL (MEDIUM thinking) when still throttled (429) after 2 retries.
COACH_MODEL=gemini-4-argon
COACH_THINKING_LEVEL=MEDIUM
COACH_FALLBACK_MODEL=gemini-3.8-flash
ONBOARDING_MODEL=gemini-3.1-flash-lite

# Telemetry
OTEL_SERVICE_NAME=running-coach
OTEL_INSTRUMENTATION_GENAI=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=1
